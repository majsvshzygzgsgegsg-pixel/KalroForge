{
  "name": "KairoForge",
  "short_name": "KairoForge",
  "description": "A local-first phone-ready Chat app and coding workspace for KairoForge.",
  "start_url": "./?mode=chat",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#090d14",
  "theme_color": "#111827",
  "icons": [
    {
      "src": "kairoforge-logo.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
