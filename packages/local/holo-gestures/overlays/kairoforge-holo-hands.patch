+# ---------- kf browser automation ----------
+# Drives the user's real Chrome over the DevTools protocol. This is the same shape of
+# capability the assistant has: navigate, read the page, click, type. It needs Chrome
+# started with a debugging port, which is a deliberate act by the user — kf will not
+# relaunch Chrome behind their back.
+KF_CDP_PORTS = [int(p) for p in os.environ.get("KF_CDP_PORTS", "9222,9223,9224").split(",")]
+KF_VISION_ENABLED = os.environ.get("KF_VISION", "1").strip() in ("1", "true", "yes", "on")
+
+
+def _cdp_target():
+    """Find a reachable Chrome DevTools endpoint. Returns (port, base_url) or None."""
+    for port in KF_CDP_PORTS:
+        data = _fetch_json(f"http://127.0.0.1:{port}/json/version")
+        if data and data.get("webSocketDebuggerUrl"):
+            return port, f"http://127.0.0.1:{port}"
+    return None
+
+
+def browser_status():
+    """Is a drivable browser attached?"""
+    found = _cdp_target()
+    if not found:
+        return {"attached": False,
+                "hint": ("Chrome is not exposing a debugging port. Quit Chrome, then run: "
+                         "/Applications/Google\\ Chrome.app/Contents/MacOS/Google\\ Chrome "
+                         "--remote-debugging-port=9222")}
+    port, base = found
+    tabs = _fetch_json(base + "/json/list") or []
+    pages = [{"title": t.get("title"), "url": t.get("url"), "id": t.get("id")}
+             for t in tabs if t.get("type") == "page"]
+    return {"attached": True, "port": port, "tabs": pages[:10], "count": len(pages)}
+
+
+def sight_command(text):
+    """Handle 'look at my screen' phrasing. Returns (reply, engine) or (None, None)."""
+    low = (text or "").strip().lower()
+    if not low:
+        return None, None
+    looks = re.search(r"\b(look at|read|see|what'?s on|whats on|check|scan)\b", low)
+    target = re.search(r"\b(my |the )?(screen|desktop|monitor|display|window|page)\b", low)
+    if not (looks and target):
+        # "what do you see" with no noun still means the screen.
+        if not re.search(r"\bwhat do you see\b|\bcan you see\b", low):
+            return None, None
+    if not KF_SEE_ENABLED:
+        return "Sight is disabled (KF_SEE=0).", "kf-sight"
+    text_seen = read_screen()
+    if not text_seen:
+        return ("I tried to look at the screen but got nothing back. Screen Recording "
+                "may not be allowed for this app."), "kf-sight"
+    return "Here is what I can read on your screen: " + text_seen[:500], "kf-sight"
+
+
+def browser_command(text):
+    """Handle browser automation phrasing. Returns (reply, engine) or (None, None)."""
+    low = (text or "").strip().lower()
+    if not low:
+        return None, None
+
+    wants_browser = re.search(r"\b(browser|chrome|tab|page|web ?page|website|webpage|url|open|go|navigate|load|visit)\b", low)
+    if not wants_browser:
+        return None, None
+
+    if re.search(r"\b(status|attached|connected|is it running|available)\b", low):
+        st = browser_status()
+        if not st.get("attached"):
+            return "I am not attached to a browser yet. " + st.get("hint", ""), "kf-browser"
+        titles = ", ".join((t.get("title") or t.get("url") or "?")[:60] for t in st.get("tabs", []))
+        return f"I am attached to Chrome on port {st['port']}. {st['count']} tab(s) open: {titles}", "kf-browser"
+
+    if re.search(r"\b(open|go to|navigate|load|visit)\b", low):
+        m = re.search(r"\b(?:open|go to|navigate to|load|visit)\s+(.+?)\s*$", text, re.I)
+        if m:
+            target = m.group(1).strip().strip("\"'")
+            # Strip conversational lead-ins so "open the browser to X" yields X.
+            target = re.sub(r"^(?:up\s+)?(?:the\s+|a\s+|my\s+)?"
+                            r"(?:browser|chrome|web ?browser|website|web ?page|page|tab|url|site)?\s*"
+                            r"(?:and\s+)?(?:go\s+to\s+|to\s+|at\s+|in\s+|on\s+)?", "", target,
+                            flags=re.I).strip()
+            target = re.sub(r"\s+(?:in|on)\s+(?:a\s+)?(?:new\s+)?tab\b.*$", "", target, flags=re.I)
+            target = re.sub(r"^(?:the\s+|a\s+|my\s+)?(?:browser|chrome|site|page)\s+", "", target,
+                            flags=re.I).strip()
+            if not target:
+                return None, None
+            if " " in target and "." not in target:
+                return None, None
+            if "." not in target:
+                target = target + ".com"
+            if not target.startswith(("http://", "https://", "about:", "file://")):
+                target = "https://" + target
+            return _browser_navigate(target)
+
+    if re.search(r"\b(read|what'?s on|summar)\w*\b.*\b(page|screen|tab)\b", low):
+        return _browser_read()
+
+    return None, None
+
+
+def _browser_navigate(url):
+    """Open a URL in a new tab of the attached browser."""
+    found = _cdp_target()
+    if not found:
+        return "I am not attached to a browser. " + browser_status().get("hint", ""), "kf-browser"
+    port, base = found
+    try:
+        import urllib.request
+        req = urllib.request.Request(base + "/json/new?" + urllib.parse.quote(url, safe=""),
+                                     method="PUT")
+        with urllib.request.urlopen(req, timeout=8) as resp:
+            data = json.loads(resp.read() or b"{}")
+        audit({"ts": time.time(), "event": "browser-navigate", "url": url})
+        title = data.get("title") or url
+        return f"Opened {url} in a new tab.", "kf-browser"
+    except Exception as exc:
+        return f"I could not open that: {type(exc).__name__}.", "kf-browser"
+
+
+def _browser_read():
+    """Read the visible text of the active tab via the DevTools protocol."""
+    found = _cdp_target()
+    if not found:
+        return "I am not attached to a browser. " + browser_status().get("hint", ""), "kf-browser"
+    port, base = found
+    tabs = _fetch_json(base + "/json/list") or []
+    page = next((t for t in tabs if t.get("type") == "page"), None)
+    if not page:
+        return "There is no open page to read.", "kf-browser"
