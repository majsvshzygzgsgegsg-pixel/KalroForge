+def resolve_intent(command, actions):
+    """Map free text to one advertised action id, or None. Never raises."""
+    allowed = set(actions or [])
+    tokens = _brain_tokens(command)
+    if not tokens:
+        return None
+    joined = " " + " ".join(tokens) + " "
+
+    def wants(*keys):
+        for k in keys:
+            for syn in BRAIN_SYNONYMS.get(k, [k]):
+                if " " in syn:
+                    if syn in joined:
+                        return True
+                elif " " + syn + " " in joined or syn in tokens:
+                    return True
+        return False
+
+    def pick(*candidates):
+        # first candidate id the page actually advertised
+        for c in candidates:
+            if c in allowed:
+                return c
+        return None
+
+    kb = wants("keyboard")
+    if kb:
+        if wants("close"):  return pick("kbclose")
+        if wants("bigger"): return pick("kbup")
+        if wants("smaller"):return pick("kbdown")
+        if wants("rotate"): return pick("kbturn")
+        if wants("center"): return pick("kbcenter")
+        return pick("keyboard")
+    # Bare size/turn/centre phrases imply the keyboard, the only scalable surface.
+    if wants("bigger"):   return pick("kbup")
+    if wants("smaller"):  return pick("kbdown")
+    if wants("rotate"):   return pick("kbturn")
+    if wants("center"):   return pick("kbcenter")
+    if wants("summary"):  return pick("gist", "summary")
+    if wants("hangup"):   return pick("hangup")
+    if wants("jarvis"):   return pick("jarvis")
+    if wants("reset"):    return pick("reset")
+    if wants("restore"):  return pick("restore")
+    if wants("tidy"):     return pick("tidy")
+    if wants("volume"):
+        return pick("mute") if wants("mute") else pick("unmute", "mute")
+    if wants("mute"):     return pick("mute")
+    if wants("close"):    return pick("close", "kbclose")
+    if wants("open"):     return pick("summon", "keyboard")
+    if wants("see") or wants("look") or wants("watch") or wants("vision"):
+        return pick("see")
+    if wants("browser"):
+        return pick("browser")
+    if wants("help"):
+        return None
+
+    # Nothing known: hand back a helpful spoken reply instead of silence.
+    return None
+
+
+HELP_REPLY = ("I can drive Holo directly: open or close the keyboard, make it bigger, "
+              "smaller or rotated, reset or tidy the board, restore cards, summarise or "
+              "open the current note, control the speaker, and refresh 3D props. "
+              "Anything touching files or repos goes to Creator mode.")
