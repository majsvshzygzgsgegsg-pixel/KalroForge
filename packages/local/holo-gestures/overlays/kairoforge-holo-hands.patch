+# ---------- kf sight ----------
+# kf can look at the screen and read it. Screen Recording is already granted on this
+# Mac, so a capture is a plain screencapture call; OCR runs through the built-in macOS
+# Vision framework (tools/ocr, compiled from tools/ocr.swift). Text never leaves the
+# machine and nothing here executes commands.
+KF_SEE_ENABLED = os.environ.get("KF_SEE", "1").strip() in ("1", "true", "yes", "on")
+KF_OCR_BIN = os.path.join(ROOT, "tools", "ocr")
+
+
+def capture_screen():
+    """Screenshot to a temp file. Returns the path, or None."""
+    import subprocess, tempfile
+    try:
+        fd, path = tempfile.mkstemp(suffix=".png", prefix="kf-screen-")
+        os.close(fd)
+        subprocess.run(["screencapture", "-x", path], check=True, timeout=20,
+                       capture_output=True)
+        return path if os.path.getsize(path) > 0 else None
+    except Exception:
+        return None
+
+
+def read_screen():
+    """Screenshot + OCR. Returns the recognized text, or an empty string."""
+    import subprocess
+    path = capture_screen()
+    if not path:
+        return ""
+    try:
+        if not os.path.exists(KF_OCR_BIN):
+            return ""
+        proc = subprocess.run([KF_OCR_BIN, path], capture_output=True, text=True, timeout=45)
+        text = " ".join((proc.stdout or "").split())
+        return text[:6000]
+    except Exception:
+        return ""
+    finally:
+        try:
+            os.unlink(path)                 # never leave screenshots lying around
+        except OSError:
+            pass
+
+
+def save_camera_frame(data_url):
+    """Persist one camera frame sent by the page. Returns a path or None."""
+    import base64, re as _re
+    try:
+        m = _re.match(r"^data:image/(png|jpeg|jpg);base64,(.+)$", str(data_url or ""), _re.S)
+        if not m:
+            return None
+        raw = base64.b64decode(m.group(2)[:8_000_000])      # cap the payload
+        if not raw:
+            return None
+        path = state_path("kf-last-seen.png")
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "wb") as f:
+            f.write(raw)
+        return path
+    except Exception:
+        return None
