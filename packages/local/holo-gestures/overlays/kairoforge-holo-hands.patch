+
+def _ollama_chat(command, context=""):
+    """One short conversational reply from the local model, or None if unavailable."""
+    import urllib.request
+    user = command if not context else f"{command}\n\n(on screen right now: {context})"
+    payload = {
+        "model": KF_MODEL,
+        "messages": [
+            {"role": "system", "content": KF_SYSTEM},
+            {"role": "user", "content": user},
+        ],
+        "stream": False,
+        "options": {"num_predict": 90, "temperature": 0.7},
+    }
+    req = urllib.request.Request(
+        KF_OLLAMA + "/api/chat",
+        data=json.dumps(payload).encode(),
+        headers={"Content-Type": "application/json"},
+    )
+    try:
+        with urllib.request.urlopen(req, timeout=KF_MODEL_TIMEOUT) as resp:
+            data = json.loads(resp.read() or b"{}")
+    except Exception:
+        return None
+    msg = (data.get("message") or {}).get("content") or data.get("response") or ""
+    msg = " ".join(str(msg).split()).strip()
+    if not msg:
+        return None
+    # Read-aloud hygiene: drop stray markdown and cap length.
+    msg = msg.replace("**", "").replace("##", "").replace("*", "")
+    if msg.startswith('"') and msg.endswith('"') and len(msg) > 2:
+        msg = msg[1:-1]
+    return msg[:400]
+
