+import Foundation
+import Vision
+import AppKit
+
+// macOS built-in OCR via the Vision framework. No dependencies, no network.
+// IMPORTANT: the .accurate recognition level can hang indefinitely on busy screenshots
+// (>45s observed, sometimes never returning). The .fast level returns in ~0.1s on the
+// same image, so that is the default and is what keeps kf responsive.
+let args = CommandLine.arguments
+guard args.count > 1 else { print(""); exit(0) }
+let mode = args.count > 2 ? args[2] : "fast"
+
+guard let img = NSImage(contentsOfFile: args[1]),
+      let tiff = img.tiffRepresentation,
+      let rep = NSBitmapImageRep(data: tiff),
+      let cg = rep.cgImage else { print(""); exit(0) }
+
+let req = VNRecognizeTextRequest()
+req.recognitionLevel = (mode == "accurate") ? .accurate : .fast
+req.usesLanguageCorrection = (mode == "accurate")
+let handler = VNImageRequestHandler(cgImage: cg, options: [:])
+do {
+    try handler.perform([req])
+    let lines = (req.results ?? []).compactMap { $0.topCandidates(1).first?.string }
+    print(lines.joined(separator: "\n"))
+} catch {
+    print("")
+}
