+# ---------- kf live data ----------
+# Real-time answers with no API key and no account. Results are cached briefly so a
+# repeated question is instant and we stay polite to the upstream services. Every
+# fetcher is timeout-guarded and returns None on any failure, so a dead network
+# degrades to an honest spoken "I could not reach that" instead of hanging.
+_KF_CACHE = {}
+_KF_CACHE_TTL = float(os.environ.get("KF_CACHE_TTL", "300"))     # seconds
+KF_LIVE_TIMEOUT = float(os.environ.get("KF_LIVE_TIMEOUT", "8"))
+KF_DEFAULT_PLACE = os.environ.get("KF_DEFAULT_PLACE", "San Francisco")
+
+
+def _cache_get(key):
+    hit = _KF_CACHE.get(key)
+    if not hit:
+        return None
+    value, stamp = hit
+    if time.time() - stamp > _KF_CACHE_TTL:
+        _KF_CACHE.pop(key, None)
+        return None
+    return value
+
+
+def _cache_put(key, value):
+    _KF_CACHE[key] = (value, time.time())
+    if len(_KF_CACHE) > 120:                      # keep the dict bounded
+        oldest = sorted(_KF_CACHE.items(), key=lambda kv: kv[1][1])[:40]
+        for k, _ in oldest:
+            _KF_CACHE.pop(k, None)
+    return value
+
+
+def _ssl_context():
+    """TLS context for outbound fetches.
+
+    Python installed from python.org on macOS ships without a CA bundle, so a plain
+    urlopen fails with CERTIFICATE_VERIFY_FAILED while curl works fine. Prefer certifi
+    when present, else the system bundle. Never disables verification.
+    """
+    import ssl
+    try:
+        import certifi
+        return ssl.create_default_context(cafile=certifi.where())
+    except Exception:
+        pass
+    for path in ("/etc/ssl/cert.pem",
+                 "/usr/local/etc/openssl/cert.pem",
+                 "/opt/homebrew/etc/openssl/cert.pem"):
+        try:
+            if os.path.exists(path):
+                return ssl.create_default_context(cafile=path)
+        except Exception:
+            continue
+    try:
+        return ssl.create_default_context()
+    except Exception:
+        return None
+
+
+_KF_SSL = None
+
+
+def _fetch_json(url):
+    """Timeout-guarded JSON GET. Returns None on any failure. Never raises."""
+    global _KF_SSL
+    import urllib.request
+    if _KF_SSL is None:
+        _KF_SSL = _ssl_context() or False
+    try:
+        req = urllib.request.Request(url, headers={"User-Agent": "kf-holo/1.0"})
+        ctx = _KF_SSL if _KF_SSL is not False else None
+        with urllib.request.urlopen(req, timeout=KF_LIVE_TIMEOUT, context=ctx) as resp:
+            raw = resp.read()
+        return json.loads(raw or b"null")
+    except Exception:
+        return None
+
+
+WMO = {0:"clear",1:"mainly clear",2:"partly cloudy",3:"overcast",45:"foggy",48:"icy fog",
+       51:"light drizzle",53:"drizzle",55:"heavy drizzle",56:"freezing drizzle",
+       57:"freezing drizzle",61:"light rain",63:"rain",65:"heavy rain",66:"freezing rain",
+       67:"freezing rain",71:"light snow",73:"snow",75:"heavy snow",77:"snow grains",
+       80:"light showers",81:"showers",82:"violent showers",85:"snow showers",
+       86:"heavy snow showers",95:"a thunderstorm",96:"thunderstorm with hail",
+       99:"a thunderstorm with heavy hail"}
+
+
+def _geocode(place):
+    """Place name -> (label, lat, lon, timezone). None if not found."""
+    key = "geo:" + place.lower()
+    cached = _cache_get(key)
+    if cached is not None:
+        return cached
+    data = _fetch_json("https://geocoding-api.open-meteo.com/v1/search?count=1&name="
+                       + urllib.parse.quote(place))
+    results = (data or {}).get("results") or []
+    if not results:
+        return None
+    r = results[0]
+    parts = [r.get("name"), r.get("admin1"), r.get("country")]
+    label = ", ".join(p for p in parts if p)
+    out = (label, r.get("latitude"), r.get("longitude"), r.get("timezone") or "auto")
+    return _cache_put(key, out)
+
+
+def live_weather(place):
+    """Current conditions as a spoken sentence, or None."""
+    key = "wx:" + (place or "").lower()
+    cached = _cache_get(key)
+    if cached is not None:
+        return cached
+    geo = _geocode(place or KF_DEFAULT_PLACE)
+    if not geo:
+        return None
+    label, lat, lon, tz = geo
+    data = _fetch_json(
+        "https://api.open-meteo.com/v1/forecast"
+        f"?latitude={lat}&longitude={lon}"
+        "&current=temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m"
+        f"&temperature_unit=fahrenheit&wind_speed_unit=mph&timezone={urllib.parse.quote(tz)}")
+    cur = (data or {}).get("current")
+    if not cur:
+        return None
+    desc = WMO.get(cur.get("weather_code"), "unsettled")
+    temp = cur.get("temperature_2m")
+    feels = cur.get("apparent_temperature")
+    hum = cur.get("relative_humidity_2m")
+    wind = cur.get("wind_speed_10m")
+    bits = []
+    if temp is not None:
+        bits.append(f"{round(temp)} degrees Fahrenheit")
+    if desc:
+        bits.append(desc)
+    if feels is not None and temp is not None and abs(feels - temp) >= 3:
+        bits.append(f"feels like {round(feels)}")
+    if hum is not None:
+        bits.append(f"{round(hum)} percent humidity")
+    if wind is not None:
+        bits.append(f"wind {round(wind)} miles per hour")
+    return _cache_put(key, f"Right now in {label}: " + ", ".join(bits) + ".")
+
+
+def live_time(place):
+    """Local clock, and the clock in a named place when we can resolve its timezone."""
+    if not place:
+        import datetime
+        now = datetime.datetime.now().astimezone()
+        return now.strftime("It is %I:%M %p on %A %d %B %Y, here.")
+    geo = _geocode(place)
+    if not geo or not geo[3]:
+        return None
+    label, _, _, tz = geo
+    key = "time:" + tz
+    cached = _cache_get(key)
+    if cached is not None:
+        return cached
+    try:
+        import datetime
+        from zoneinfo import ZoneInfo
+        now = datetime.datetime.now(ZoneInfo(tz))
+        return _cache_put(key, f"It is {now.strftime('%I:%M %p on %A %d %B %Y')} in {label}.")
+    except Exception:
+        return None
+
+
+def live_summary(topic):
+    """One-paragraph factual summary of a topic, or None."""
+    key = "wiki:" + topic.lower().strip()
+    cached = _cache_get(key)
+    if cached is not None:
+        return cached
+    data = _fetch_json("https://en.wikipedia.org/api/rest_v1/page/summary/"
+                       + urllib.parse.quote(topic.strip().replace(" ", "_")))
+    extract = (data or {}).get("extract")
+    if not extract or (data or {}).get("type") == "disambiguation":
+        return None
+    extract = " ".join(str(extract).split())
+    if len(extract) > 420:
+        extract = extract[:417].rsplit(" ", 1)[0] + "..."
+    return _cache_put(key, extract)
+
+
+# Question shapes that mean "go get live facts first".
+KF_WEATHER_RE = re.compile(
+    r"\b(weather|forecast|temperature|how (hot|cold|warm)|raining|rain|snowing|snow|"
+    r"humid|humidity|windy|wind)\b", re.I)
+KF_TIME_RE = re.compile(
+    r"\b(what time|what'?s the time|current time|time is it|what day|what'?s the date|"
+    r"today'?s date|what'?s today)\b", re.I)
+KF_SUMMARY_RE = re.compile(
+    r"\b(who is|who was|who are|what is|what are|tell me about|what happened to|"
+    r"look up|search for|explain)\b", re.I)
+
+
+def _extract_place(text):
+    """Pull a place name out of the question, or None for the default city."""
+    m = re.search(r"\b(?:in|at|for|near)\s+([A-Za-z][A-Za-z .'\-]{1,40}?)\s*[?.,!]*$", text.strip())
+    if m:
+        place = m.group(1).strip()
+        place = re.sub(r"\b(right now|today|currently|tomorrow|tonight)\b", "", place, flags=re.I).strip()
+        if place and place.lower() not in ("here", "my area", "the area", "me"):
+            return place
+    return None
+
+
+def live_answer(command):
+    """Try to answer with real-time data. Returns (reply, kind) or (None, None)."""
+    text = command.strip()
+    if not text:
+        return None, None
+    has_urls = bool(re.search(r"https?://", text))
+
+    if KF_WEATHER_RE.search(text):
+        place = _extract_place(text) or KF_DEFAULT_PLACE
+        reply = live_weather(place)
+        return (reply, "weather") if reply else (None, None)
+
+    if KF_TIME_RE.search(text):
+        place = _extract_place(text)
+        reply = live_time(place)
+        return (reply, "time") if reply else (None, None)
+
+    if not has_urls and KF_SUMMARY_RE.search(text):
+        m = re.search(r"\b(?:who is|who was|who are|what is|what are|tell me about|"
+                      r"look up|search for|explain)\s+(.{2,60})$", text, re.I)
+        topic = (m.group(1) if m else "").strip(" ?.!,\"'")
+        topic = re.sub(r"^(the|a|an)\s+", "", topic, flags=re.I)
+        if topic and len(topic) > 1:
+            reply = live_summary(topic)
+            return (reply, "summary") if reply else (None, None)
+    return None, None
+
+
