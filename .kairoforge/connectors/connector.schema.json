{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairoforge.local/schemas/connector.schema.json",
  "title": "KairoForge Connector",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "source", "localPath", "install", "creatorMode"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["local-service", "remote-service", "github-project"] },
    "source": { "type": "string", "minLength": 1 },
    "localPath": { "type": "string", "minLength": 1 },
    "install": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "creatorMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editable", "allowedActions", "notes"],
      "properties": {
        "editable": { "type": "boolean" },
        "allowedActions": {
          "type": "array",
          "items": { "enum": ["clone", "inspect", "edit", "run", "document"] }
        },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
