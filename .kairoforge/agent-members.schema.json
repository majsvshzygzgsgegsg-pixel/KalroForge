{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairoforge.local/schemas/agent-members.schema.json",
  "title": "KairoForge Permanent Agent Members",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "product", "members"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "product": {
      "const": "KairoForge"
    },
    "description": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "description",
          "defaultPrompt",
          "capabilities",
          "fileAccess",
          "permanent",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": ["lead", "specialist"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "defaultPrompt": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "fileAccess": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "root", "rules"],
            "properties": {
              "mode": {
                "enum": ["read-only", "workspace-write"]
              },
              "root": {
                "type": "string",
                "minLength": 1
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "permanent": {
            "const": true
          },
          "status": {
            "enum": ["active", "retired"]
          }
        }
      }
    }
  }
}
